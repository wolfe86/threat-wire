# Change the time BEFORE the first enable. Editing OnCalendar later on a
# Persistent=true timer can fire a "missed" run as soon as you daemon-reload.
[Unit]
Description=Run the Threat Wire weekly report on Fridays

[Timer]
OnCalendar=Fri *-*-* 18:00:00
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
