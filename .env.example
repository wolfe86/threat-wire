# Copy to .env (next to threatwire.py) or ~/.config/threatwire.env, chmod 600.
# Both files are read; values already in the environment win.

# From @BotFather. The bot must be an administrator of the channel.
THREATWIRE_BOT_TOKEN=123456789:replace-with-your-bot-token

# Channel ID: a public channel can use @yourchannel; a private one needs the
# numeric ID, which starts with -100.
THREATWIRE_CHAT_ID=@yourchannel

# Optional - only for the weekly report (threatwire_weekly.py).
# THREATWIRE_WEEKLY_OUTDIR=/path/to/reports
# CLAUDE_BIN=/usr/local/bin/claude
